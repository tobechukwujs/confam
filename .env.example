# Copy to .env (git-ignored). Never commit real values.

# ---- apps/web (Vercel project settings; Root Directory = apps/web) ----
# Where the web app's server reaches the API. Server-side only, so no CORS needed.
API_URL=http://localhost:8000
# "1" shows links to the fictional sample verdicts on the home page. Use only
# where the API has CONFAM_SEED_SAMPLES=1.
SHOW_SAMPLES=1

# ---- services/api (Render environment) ----
# Origins allowed by CORS, comma separated. The web app calls the API server-side,
# so this only matters for browser clients added later.
CONFAM_CORS_ORIGINS=http://localhost:3000
# "1" seeds the fictional sample verdicts (fixtures/sec-sim/sample-verdicts.json).
CONFAM_SEED_SAMPLES=1
# Per-IP requests per minute on POST /v1/checks.
CONFAM_RATE_LIMIT_PER_MINUTE=30
# Salt for hashing IPs in the rate limiter. Set a long random value in production.
CONFAM_IP_SALT=change-me
# Optional: path to a record JSON file. Defaults to fixtures/sec-sim/notices.json.
# CONFAM_RECORD_PATH=
